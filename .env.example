# Copy this file to .env and fill in your values
# Never commit .env to git

# Required for Gemini embeddings and LLM chains
GEMINI_API_KEY="Paste your Gemini API key here"

# Local paths (relative paths resolve against the project root)
CHROMA_PATH=./data/chroma_index
CHROMA_COLLECTION=research_papers
FIGURES_PATH=./data/figures
FIGURES_INDEX_PATH=./data/figures_index.json
PAPERS_PATH=./data/papers
EVAL_QUESTIONS_PATH=./evaluation/eval_questions.csv

# Ingestion settings
CHUNK_SIZE=256
CHUNK_OVERLAP=32
OCR_DPI=200
OCR_MIN_CHARS=50
MAX_FILE_SIZE_MB=50

# Retrieval & reranking settings
TOP_K=6
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM & embedding models
LLM_MODEL=gemini-3.8-pro
EMBEDDING_MODEL=gemini-embedding-2
