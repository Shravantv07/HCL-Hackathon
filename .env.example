# Copy this file to .env and fill in your values
# Never commit .env to git

OPENAI_API_KEY=sk-...your-key-here...

# Local paths (defaults work if you run from project root)
CHROMA_PATH=./data/chroma_index
FIGURES_PATH=./data/figures
PAPERS_PATH=./data/papers

# Retrieval settings
TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# LLM settings
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
