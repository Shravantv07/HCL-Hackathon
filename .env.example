# Copy this file to .env and fill in your values
# Never commit .env to git

GEMINI_API_KEY="Paste your Gemini API key here"

# Local paths (defaults work if you run from project root)
CHROMA_PATH=./data/chroma_index
FIGURES_PATH=./data/figures
PAPERS_PATH=./data/papers

# Retrieval settings
TOP_K=6
CHUNK_SIZE=256
CHUNK_OVERLAP=32

# LLM settings
LLM_MODEL=gemini-3.8-pro
EMBEDDING_MODEL=gemini-embedding-2
